# Copy to .env and fill in your own values. Never commit .env.
#
# Find these under: Supabase dashboard -> Project Settings -> Database.
# When deploying to Streamlit Cloud, set the same five keys in the app's
# Secrets panel instead of using a .env file.

SUPABASE_HOST=db.<your-project-ref>.supabase.co
SUPABASE_PORT=5432
SUPABASE_USER=postgres
SUPABASE_PASSWORD=<your-database-password>
SUPABASE_DB=postgres
